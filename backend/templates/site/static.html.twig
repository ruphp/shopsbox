{% extends 'base.html.twig' %}

{% block title %}{{ page.title }} - ShopsBox{% endblock %}
{% block og_title %}{{ page.title }} - ShopsBox{% endblock %}
{% block meta_description %}{{ page.description }}{% endblock %}
{% block og_description %}{{ page.description }}{% endblock %}
{% block canonical_url %}{{ site_public_base_url ~ path('site_static', {page: page.slug}) }}{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}

    <main class="main">
        <section class="section legal-page">
            <div class="wrap">
                <p class="eyebrow">ShopsBox.ru</p>
                <h1>{{ page.title }}</h1>
                <p class="muted">{{ page.description }}</p>

                <div class="legal-note">
                    {% for paragraph in page.paragraphs %}
                        <p>{{ paragraph }}</p>
                    {% endfor %}
                </div>
            </div>
        </section>
    </main>

    {% include 'site/_footer.html.twig' %}
{% endblock %}
