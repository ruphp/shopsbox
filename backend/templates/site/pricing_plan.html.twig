{% extends 'base.html.twig' %}

{% block title %}Тариф {{ plan.title }} - ShopsBox{% endblock %}
{% block og_title %}Тариф {{ plan.title }} - ShopsBox{% endblock %}
{% block meta_description %}Описание тарифа {{ plan.title }} для создания интернет-магазина на ShopsBox: стоимость, возможности, ограничения и условия подключения.{% endblock %}
{% block og_description %}Описание тарифа {{ plan.title }} для интернет-магазина на ShopsBox.{% endblock %}
{% block canonical_url %}{{ site_public_base_url ~ path('site_pricing_plan', {plan: plan.slug}) }}{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}

    <main class="main">
        <section class="section pricing-page">
            <div class="wrap">
                <p class="eyebrow">Тариф ShopsBox</p>
                <h1>{{ plan.title }}</h1>
                <p class="muted">{{ plan.description }}</p>

                <div class="checkout-layout">
                    <article class="pricing-card pricing-card--wide">
                        <p class="pricing-card__subtitle">{{ plan.subtitle }}</p>
                        <p class="pricing-price"><strong>{{ plan.price }}</strong> <span>{{ plan.period }}</span></p>

                        <h2>Что входит</h2>
                        <ul class="pricing-list">
                            {% for feature in plan.features %}
                                <li>{{ feature }}</li>
                            {% endfor %}
                        </ul>

                        <h2>Ограничения и условия</h2>
                        <ul class="pricing-list">
                            {% for limit in plan.limits %}
                                <li>{{ limit }}</li>
                            {% endfor %}
                        </ul>
                    </article>

                    <aside class="checkout-panel">
                        <h2>Оформление</h2>
                        <p>Тариф оформляется для владельца магазина ShopsBox. После подключения оплаты здесь будет доступна онлайн-оплата банковской картой или через платежного провайдера.</p>
                        {% if plan.checkout %}
                            <a class="button" href="{{ path('site_pricing_checkout', {plan: plan.slug}) }}">Перейти к оформлению</a>
                        {% else %}
                            <a class="button" href="{{ path('owner_register_form') }}">Начать бесплатно</a>
                        {% endif %}
                        <p class="muted">Перед оплатой можно уточнить условия по email ruphp@mail.ru или телефону 8 929 203-04-99.</p>
                    </aside>
                </div>
            </div>
        </section>
    </main>

    {% include 'site/_footer.html.twig' %}
{% endblock %}
