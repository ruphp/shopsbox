{% extends 'storefront/_layout.html.twig' %}

{% set store = view.store %}
{% set product = view.product %}

{% block title %}{{ product.name }} - {{ store.name }}{% endblock %}
{% block og_title %}{{ product.name }} - {{ store.name }}{% endblock %}
{% block meta_description %}{{ product.description ?: product.name ~ ' в магазине ' ~ store.name ~ ' на ShopsBox.' }}{% endblock %}
{% block og_description %}{{ product.description ?: product.name ~ ' в магазине ' ~ store.name ~ '.' }}{% endblock %}
{% block og_image %}{{ product.imageUrl ? (product.imageUrl starts with 'http' ? product.imageUrl : site_public_base_url ~ product.imageUrl) : parent() }}{% endblock %}
{% block canonical_url %}{{ site_public_base_url ~ app.request.pathInfo }}{% endblock %}

{% block storefront_content %}
    <section class="section product-page">
        <div class="wrap">
            <p><a href="{{ path(storefront_products_route, {storeSlug: store.slug}) }}">Назад к товарам</a></p>

            <div class="product-detail">
                <div class="product-gallery" data-product-gallery>
                    <div class="product-detail-media">
                        {% if product.imageUrl %}
                            <img src="{{ product.imageUrl }}" alt="{{ product.name }}" data-gallery-main>
                            <span class="product-gallery-lens" data-gallery-lens aria-hidden="true"></span>
                            <button class="product-gallery-expand" type="button" data-gallery-expand aria-label="Открыть изображение на весь экран" title="Открыть на весь экран">
                                <span class="zoom-icon" aria-hidden="true"></span>
                            </button>
                        {% else %}
                            <span>{{ product.name }}</span>
                        {% endif %}
                    </div>
                    {% if product.imageUrl %}
                        <div class="product-gallery-zoom" data-gallery-zoom aria-hidden="true"></div>
                    {% endif %}
                    {% if product.imageUrls|length > 1 %}
                        <div class="product-gallery-thumbnails" aria-label="Фотографии товара">
                            {% for imageUrl in product.imageUrls %}
                                <button class="product-gallery-thumbnail{{ loop.first ? ' is-active' : '' }}" type="button" data-gallery-image="{{ imageUrl }}" aria-label="Показать фотографию {{ loop.index }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}">
                                    <img src="{{ imageUrl }}" alt="">
                                </button>
                            {% endfor %}
                        </div>
                    {% endif %}
                    {% if product.imageUrl %}
                        <dialog class="product-lightbox" data-product-lightbox aria-label="Увеличенное изображение товара">
                            <button class="product-lightbox-close" type="button" data-lightbox-close aria-label="Закрыть увеличенное изображение" title="Закрыть">×</button>
                            <img src="{{ product.imageUrl }}" alt="{{ product.name }}" data-lightbox-image>
                        </dialog>
                    {% endif %}
                </div>

                <div class="product-detail-body">
                    {% if product.category %}
                        <a class="product-category" href="{{ path(storefront_category_route, {storeSlug: store.slug, categorySlug: product.category.slug}) }}">{{ product.category.name }}</a>
                    {% endif %}
                    <h1>{{ product.name }}</h1>
                    <p class="muted">{{ product.description ?: 'Описание появится позже.' }}</p>

                    <p class="product-price">{{ product.price|number_format(2, ',', ' ') }} {{ currency_symbol }}</p>

                    <form class="add-to-cart" method="post" action="{{ path(storefront_cart_add_route, {storeSlug: store.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('cart_add') }}">
                        <input type="hidden" name="product_id" value="{{ product.id }}">
                        {% if product.variants is not empty %}
                            <div class="product-field product-field-variant">
                                <label for="variant_id">Вариант</label>
                                <select id="variant_id" name="variant_id" required>
                                    <option value="">Выберите вариант</option>
                                    {% for variant in product.variants %}
                                        <option value="{{ variant.id }}">
                                            {{ variant.name }}{% if variant.priceAdjustment %} (+{{ variant.priceAdjustment|number_format(2, ',', ' ') }} {{ currency_symbol }}){% endif %}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}
                        <div class="product-field product-field-quantity">
                            <label for="quantity">Количество</label>
                            <input id="quantity" name="quantity" type="number" min="1" max="99" value="1" required>
                        </div>
                        <button class="button" type="submit">Добавить в корзину</button>
                    </form>

                    {% if product.optionGroups is not empty %}
                        <div class="product-panel product-variants-info">
                            <h2>Опции</h2>
                            {% for group in product.optionGroups %}
                                <div class="option-group">
                                    <strong>{{ group.name }}</strong>
                                    <div class="option-values">
                                        {% for value in group.values %}
                                            <span>{{ value.value }}</span>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% if product.variants is not empty %}
                        <div class="product-panel">
                            <h2>Вариации</h2>
                            <div class="variant-list">
                                {% for variant in product.variants %}
                                    <article class="variant-row">
                                        <div>
                                            <strong>{{ variant.name }}</strong>
                                            <span>{{ variant.optionValues|join(' / ') }}</span>
                                        </div>
                                        <small>Артикул: {{ variant.sku }}</small>
                                        {% if variant.priceAdjustment %}
                                            <small>Доплата: {{ variant.priceAdjustment|number_format(2, ',', ' ') }} {{ currency_symbol }}</small>
                                        {% endif %}
                                    </article>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {% if product.attributes is not empty %}
                        <div class="product-panel">
                            <h2>Характеристики</h2>
                            <dl class="attribute-list">
                                {% for attribute in product.attributes %}
                                    <div>
                                        <dt>{{ attribute.name }}</dt>
                                        <dd>{{ attribute.value }}</dd>
                                    </div>
                                {% endfor %}
                            </dl>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
    <script>
        document.querySelectorAll('[data-product-gallery]').forEach(function (gallery) {
            var mainImage = gallery.querySelector('[data-gallery-main]');
            var expandButton = gallery.querySelector('[data-gallery-expand]');
            var media = gallery.querySelector('.product-detail-media');
            var lens = gallery.querySelector('[data-gallery-lens]');
            var zoomPane = gallery.querySelector('[data-gallery-zoom]');
            var lightbox = gallery.querySelector('[data-product-lightbox]');
            var lightboxImage = gallery.querySelector('[data-lightbox-image]');
            var closeButton = gallery.querySelector('[data-lightbox-close]');

            function openLightbox() {
                lightboxImage.src = mainImage.src;
                lightboxImage.alt = mainImage.alt;
                lightbox.showModal();
            }

            if (expandButton && lightbox) {
                expandButton.addEventListener('click', openLightbox);
                closeButton.addEventListener('click', function () {
                    lightbox.close();
                });
                lightbox.addEventListener('click', function (event) {
                    if (event.target === lightbox) {
                        lightbox.close();
                    }
                });
            }

            function updateZoomImage() {
                if (zoomPane && mainImage) {
                    zoomPane.style.backgroundImage = 'url("' + mainImage.src.replace(/"/g, '\\"') + '")';
                }
            }

            function moveZoom(event) {
                if (!media || !lens || !zoomPane || window.matchMedia('(hover: none), (pointer: coarse), (max-width: 979px)').matches) {
                    return;
                }

                var rect = media.getBoundingClientRect();
                var lensWidth = lens.offsetWidth;
                var lensHeight = lens.offsetHeight;
                var left = Math.max(0, Math.min(event.clientX - rect.left - lensWidth / 2, rect.width - lensWidth));
                var top = Math.max(0, Math.min(event.clientY - rect.top - lensHeight / 2, rect.height - lensHeight));
                var zoom = zoomPane.clientWidth / lensWidth;
                var naturalWidth = mainImage.naturalWidth || rect.width;
                var naturalHeight = mainImage.naturalHeight || rect.height;
                var coverScale = Math.max(rect.width / naturalWidth, rect.height / naturalHeight);
                var renderedWidth = naturalWidth * coverScale;
                var renderedHeight = naturalHeight * coverScale;
                var offsetX = (rect.width - renderedWidth) / 2;
                var offsetY = (rect.height - renderedHeight) / 2;

                lens.style.transform = 'translate(' + left + 'px, ' + top + 'px)';
                zoomPane.style.backgroundSize = (renderedWidth * zoom) + 'px ' + (renderedHeight * zoom) + 'px';
                zoomPane.style.backgroundPosition = ((offsetX - left) * zoom) + 'px ' + ((offsetY - top) * zoom) + 'px';
            }

            if (media && lens && zoomPane && mainImage) {
                updateZoomImage();
                media.addEventListener('mouseenter', function (event) {
                    gallery.classList.add('is-zooming');
                    moveZoom(event);
                });
                media.addEventListener('mousemove', moveZoom);
                media.addEventListener('mouseleave', function () {
                    gallery.classList.remove('is-zooming');
                });
            }

            gallery.querySelectorAll('[data-gallery-image]').forEach(function (button) {
                button.addEventListener('click', function () {
                    mainImage.src = button.dataset.galleryImage;
                    updateZoomImage();
                    gallery.querySelectorAll('[data-gallery-image]').forEach(function (item) {
                        var active = item === button;
                        item.classList.toggle('is-active', active);
                        item.setAttribute('aria-pressed', active ? 'true' : 'false');
                    });
                });
            });
        });
    </script>
{% endblock %}
