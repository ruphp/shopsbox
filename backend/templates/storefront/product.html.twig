{% extends 'storefront/_layout.html.twig' %}

{% set store = view.store %}
{% set product = view.product %}

{% block title %}{{ product.name }} - {{ store.name }}{% endblock %}
{% block og_title %}{{ product.name }} - {{ store.name }}{% endblock %}
{% block meta_description %}{{ product.description ?: product.name ~ ' в магазине ' ~ store.name ~ ' на ShopsBox.' }}{% endblock %}
{% block og_description %}{{ product.description ?: product.name ~ ' в магазине ' ~ store.name ~ '.' }}{% endblock %}
{% block canonical_url %}{{ site_public_base_url ~ path('storefront_product', {storeSlug: store.slug, productSlug: product.slug}) }}{% endblock %}

{% block storefront_content %}
    <section class="section">
        <div class="wrap">
            <p><a href="{{ path('storefront_products', {storeSlug: store.slug}) }}">Назад к товарам</a></p>
            <h1>{{ product.name }}</h1>
            <p class="muted">{{ product.description ?: 'Описание появится позже.' }}</p>
        </div>
    </section>
{% endblock %}
