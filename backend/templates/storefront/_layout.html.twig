{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/storefront.css?v=20261012-exit-label">
{% endblock %}

{% block body %}
    {% set current_route = app.request.attributes.get('_route')|default('') %}
    {% set route_prefix = current_route starts with 'local_host_' ? 'local_host_' : (current_route starts with 'host_' ? 'host_' : '') %}
    {% set storefront_home_route = route_prefix ~ 'storefront_home' %}
    {% set storefront_products_route = route_prefix ~ 'storefront_products' %}
    {% set storefront_product_route = route_prefix ~ 'storefront_product' %}
    {% set storefront_category_route = route_prefix ~ 'storefront_category' %}
    {% set storefront_cart_route = route_prefix ~ 'storefront_cart' %}
    {% set storefront_cart_add_route = route_prefix ~ 'storefront_cart_add' %}
    {% set storefront_cart_update_route = route_prefix ~ 'storefront_cart_update' %}
    {% set storefront_checkout_route = route_prefix ~ 'storefront_checkout' %}
    {% set currency_symbol = store.currency == 'RUB' ? '₽' : store.currency %}
    <header class="header">
        <div class="wrap nav">
            <a class="brand" href="{{ path(storefront_home_route, {storeSlug: store.slug}) }}">{{ store.name }}</a>
            <nav class="links" aria-label="Навигация витрины">
                <a href="{{ path(storefront_home_route, {storeSlug: store.slug}) }}">Главная</a>
                <a href="{{ path(storefront_products_route, {storeSlug: store.slug}) }}">Товары</a>
                {% set cart_count = app.session.get('shopsbox_cart_' ~ store.slug)|default([])|length %}
                <a href="{{ path(storefront_cart_route, {storeSlug: store.slug}) }}">Корзина{% if cart_count > 0 %} ({{ cart_count }}){% endif %}</a>
                {% if app.session.get('shopsbox_auth_email') %}
                    <a href="{{ path('owner_dashboard') }}">В кабинет</a>
                    <form class="nav-form" method="post" action="{{ path('auth_logout') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
                        <button class="storefront-exit" type="submit">{{ store.slug == 'demo-store' ? 'Выйти из демо-витрины' : 'Выйти из витрины' }}</button>
                    </form>
                {% endif %}
            </nav>
        </div>
    </header>

    <main class="main">
        {% block storefront_content %}{% endblock %}
    </main>

    <footer class="footer">
        <div class="wrap nav">
            <span>{{ store.name }}</span>
            <span>{{ store.domain }}</span>
        </div>
    </footer>
{% endblock %}
