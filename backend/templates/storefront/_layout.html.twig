{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/storefront.css?v=20261013-benefit-icons">
{% endblock %}

{% block body %}
    {% set current_route = app.request.attributes.get('_route')|default('') %}
    {% set route_prefix = current_route starts with 'local_host_' ? 'local_host_' : (current_route starts with 'host_' ? 'host_' : '') %}
    {% set storefront_home_route = route_prefix ~ 'storefront_home' %}
    {% set storefront_products_route = route_prefix ~ 'storefront_products' %}
    {% set storefront_product_route = route_prefix ~ 'storefront_product' %}
    {% set storefront_category_route = route_prefix ~ 'storefront_category' %}
    {% set storefront_cart_route = route_prefix ~ 'storefront_cart' %}
    {% set storefront_cart_add_route = route_prefix ~ 'storefront_cart_add' %}
    {% set storefront_cart_update_route = route_prefix ~ 'storefront_cart_update' %}
    {% set storefront_checkout_route = route_prefix ~ 'storefront_checkout' %}
    {% set currency_symbol = store.currency == 'RUB' ? '₽' : store.currency %}
    {% set storefront_logo = store.themeSettings.logo_image_url|default('') %}
    {% set show_store_name_with_logo = store.themeSettings.show_store_name_with_logo|default(false) %}
    {% if appearancePreview|default(false) %}
        <div class="storefront-preview-bar">
            <div class="wrap">
                <div><strong>Предпросмотр черновика</strong><span>Эту версию видите только вы.</span></div>
                <a href="{{ path('owner_store_appearance') }}">Вернуться к редактору</a>
            </div>
        </div>
    {% endif %}
    <header class="header storefront-header responsive-header" data-responsive-header>
        <div class="wrap nav storefront-header-row responsive-header-row">
            <a class="brand" href="{{ path(storefront_home_route, {storeSlug: store.slug}) }}">
                {% if storefront_logo %}
                    <img class="storefront-logo" src="{{ storefront_logo }}" alt="{{ store.name }}">
                {% endif %}
                {% if not storefront_logo or show_store_name_with_logo %}<span class="storefront-brand-name">{{ store.name }}</span>{% endif %}
            </a>
            <button class="responsive-menu-toggle" type="button" aria-expanded="false" aria-controls="storefront-menu" aria-label="Открыть меню" data-responsive-menu-toggle>
                <span></span><span></span><span></span>
            </button>
            <nav class="links storefront-menu responsive-menu" id="storefront-menu" aria-label="Навигация витрины" data-responsive-menu>
                <a href="{{ path(storefront_home_route, {storeSlug: store.slug}) }}">Главная</a>
                <a href="{{ path(storefront_products_route, {storeSlug: store.slug}) }}">Товары</a>
                {% set cart_count = app.session.get('shopsbox_cart_' ~ store.slug)|default([])|length %}
                <a href="{{ path(storefront_cart_route, {storeSlug: store.slug}) }}">Корзина{% if cart_count > 0 %} ({{ cart_count }}){% endif %}</a>
                {% if app.session.get('shopsbox_auth_email') %}
                    <a href="{{ path('owner_dashboard') }}">{{ store.slug == 'demo-store' ? 'Выйти из демо-витрины' : 'Выйти из витрины' }}</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <main class="main">
        {% block storefront_content %}{% endblock %}
    </main>

    <footer class="footer">
        <div class="wrap nav">
            <span>{{ store.name }}</span>
            <span>{{ store.domain }}</span>
        </div>
    </footer>
{% endblock %}
