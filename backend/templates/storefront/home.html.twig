{% extends 'storefront/_layout.html.twig' %}

{% set store = view.store %}

{% block title %}{{ store.name }}{% endblock %}
{% block og_title %}{{ store.name }}{% endblock %}
{% block meta_description %}{{ store.name }} - публичная витрина магазина на ShopsBox.{% endblock %}
{% block og_description %}Открытая витрина магазина {{ store.name }} с опубликованными товарами.{% endblock %}
{% block canonical_url %}{{ site_public_base_url ~ path('storefront_home', {storeSlug: store.slug}) }}{% endblock %}

{% block storefront_content %}
    <section class="hero">
        <div class="wrap">
            <h1>{{ store.name }}</h1>
            <p>Витрина магазина открыта. Ниже первые опубликованные товары.</p>
            <a class="button" href="{{ path('storefront_products', {storeSlug: store.slug}) }}">Смотреть товары</a>
        </div>
    </section>

    <section class="section">
        <div class="wrap">
            <h2>Популярное</h2>

            {% if view.featuredProducts is empty %}
                <p class="muted">Пока нет опубликованных товаров.</p>
            {% else %}
                <div class="grid">
                    {% for product in view.featuredProducts %}
                        <article class="product">
                            <h3><a href="{{ path('storefront_product', {storeSlug: store.slug, productSlug: product.slug}) }}">{{ product.name }}</a></h3>
                            <p class="muted">{{ product.description ?: 'Описание появится позже.' }}</p>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
