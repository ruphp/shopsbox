{% extends 'storefront/_layout.html.twig' %}

{% set store = view.store %}
{% set theme = store.themeSettings %}
{% set sections = theme.sections|default(['hero', 'featured']) %}
{% set template = theme.template|default('classic') %}
{% set primary_color = theme.primary_color|default('#0077b6') %}
{% set hero_slides = theme.hero_slides|default([]) %}
{% if hero_slides is empty %}
    {% set hero_slides = [{
        eyebrow: theme.hero_eyebrow|default(''),
        title: theme.hero_title|default('') ?: store.name,
        text: theme.hero_text|default('') ?: 'Витрина магазина открыта. Ниже первые опубликованные товары.',
        button_label: theme.hero_button_label|default('Смотреть товары'), button_url: '',
        secondary_label: '', secondary_url: '',
        alignment: theme.hero_alignment|default('left'), overlay: theme.hero_overlay|default(60),
        image_url: theme.hero_image_url|default('')
    }] %}
{% endif %}
{% set first_hero_slide = hero_slides|first %}
{% set hero_image = first_hero_slide.image_url|default('') %}
{% set featured_title = theme.featured_title|default('Популярное') %}
{% set featured_columns = theme.featured_columns|default(4) %}
{% set featured_show_description = theme.featured_show_description|default(true) %}
{% set featured_layout = theme.featured_layout|default('grid') %}
{% set seo_title = theme.seo_title|default('') ?: store.name %}
{% set seo_description = theme.seo_description|default('') ?: (store.publicDescription|default('') ?: 'Открытая витрина магазина ' ~ store.name ~ ' с опубликованными товарами.') %}

{% block title %}{{ seo_title }}{% endblock %}
{% block og_title %}{{ seo_title }}{% endblock %}
{% block meta_description %}{{ seo_description }}{% endblock %}
{% block og_description %}{{ seo_description }}{% endblock %}
{% block og_image %}{{ hero_image ? (hero_image starts with 'http' ? hero_image : site_public_base_url ~ hero_image) : parent() }}{% endblock %}
{% block canonical_url %}{{ site_public_base_url ~ path('storefront_home', {storeSlug: store.slug}) }}{% endblock %}

{% block storefront_content %}
    <div class="storefront-page storefront-template-{{ template }}" style="--storefront-accent: {{ primary_color }}">
        {% for section in sections %}
            {% if section == 'hero' %}
                <section class="storefront-hero-slider" data-hero-slider data-autoplay="{{ theme.hero_autoplay|default(true) ? '1' : '0' }}" data-interval="{{ theme.hero_interval|default(5) * 1000 }}" aria-label="Главные предложения">
                    <div class="storefront-hero-slides">
                        {% for slide in hero_slides %}
                            {% set slide_image = slide.image_url|default('') %}
                            {% set primary_url = slide.button_url|default('') ?: path(storefront_products_route, {storeSlug: store.slug}) %}
                            <article class="hero storefront-hero storefront-hero-slide align-{{ slide.alignment|default('left') }} {{ slide_image ? 'has-image' : '' }} {{ loop.first ? 'is-active' : '' }}" data-hero-slide aria-hidden="{{ loop.first ? 'false' : 'true' }}" style="--storefront-hero-overlay: {{ slide.overlay|default(60) / 100 }}{% if slide_image %}; --storefront-hero-image: url('{{ slide_image }}'){% endif %}">
                                <div class="wrap">
                                    {% if slide.eyebrow|default('') %}<p class="storefront-hero-eyebrow">{{ slide.eyebrow }}</p>{% endif %}
                                    {% if loop.first %}<h1>{{ slide.title }}</h1>{% else %}<h2>{{ slide.title }}</h2>{% endif %}
                                    {% if slide.text|default('') %}<p>{{ slide.text }}</p>{% endif %}
                                    {% if slide.button_label|default('') or slide.secondary_label|default('') %}
                                        <div class="storefront-hero-actions">
                                            {% if slide.button_label|default('') %}<a class="button" href="{{ primary_url }}">{{ slide.button_label }}</a>{% endif %}
                                            {% if slide.secondary_label|default('') and slide.secondary_url|default('') %}<a class="button button-secondary" href="{{ slide.secondary_url }}">{{ slide.secondary_label }}</a>{% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                    {% if hero_slides|length > 1 %}
                        <button class="storefront-slider-arrow is-prev" type="button" data-slider-prev aria-label="Предыдущий слайд">‹</button>
                        <button class="storefront-slider-arrow is-next" type="button" data-slider-next aria-label="Следующий слайд">›</button>
                        <div class="storefront-slider-dots" role="tablist" aria-label="Выбор слайда">
                            {% for slide in hero_slides %}<button type="button" class="{{ loop.first ? 'is-active' : '' }}" data-slider-dot="{{ loop.index0 }}" aria-label="Слайд {{ loop.index }}" aria-selected="{{ loop.first ? 'true' : 'false' }}"></button>{% endfor %}
                        </div>
                    {% endif %}
                </section>
            {% elseif section == 'featured' %}
                <section class="section storefront-featured">
                    <div class="wrap">
                        <h2>{{ featured_title }}</h2>

                        {% if view.featuredProducts is empty %}
                            <p class="muted">Пока нет опубликованных товаров.</p>
                        {% else %}
                            <div class="storefront-product-block {{ featured_layout == 'carousel' ? 'is-carousel' : '' }}"{% if featured_layout == 'carousel' %} data-product-carousel{% endif %}>
                                {% if featured_layout == 'carousel' %}<button type="button" class="product-carousel-arrow is-prev" data-carousel-prev aria-label="Показать предыдущие товары">‹</button>{% endif %}
                                <div class="product-grid storefront-product-grid columns-{{ featured_columns }}"{% if featured_layout == 'carousel' %} data-carousel-track tabindex="0"{% endif %}>
                                {% for product in view.featuredProducts %}
                                    <article class="product-card">
                                        <a class="product-media" href="{{ path(storefront_product_route, {storeSlug: store.slug, productSlug: product.slug}) }}">
                                            {% if product.imageUrl %}
                                                <img src="{{ product.imageUrl }}" alt="{{ product.name }}" loading="lazy">
                                            {% else %}
                                                <span>{{ product.name }}</span>
                                            {% endif %}
                                        </a>
                                        <div class="product-card-body">
                                            <h3><a href="{{ path(storefront_product_route, {storeSlug: store.slug, productSlug: product.slug}) }}">{{ product.name }}</a></h3>
                                            {% if featured_show_description %}<p class="muted">{{ product.description ?: 'Описание появится позже.' }}</p>{% endif %}
                                            <p class="product-price product-price-small">{{ product.price|number_format(2, ',', ' ') }} {{ currency_symbol }}</p>
                                        </div>
                                    </article>
                                {% endfor %}
                                </div>
                                {% if featured_layout == 'carousel' %}<button type="button" class="product-carousel-arrow is-next" data-carousel-next aria-label="Показать следующие товары">›</button>{% endif %}
                            </div>
                        {% endif %}
                    </div>
                </section>
            {% elseif section == 'categories' %}
                <section class="section storefront-categories">
                    <div class="wrap">
                        <h2>Категории</h2>
                        {% if view.categories is empty %}
                            <p class="muted">Категории пока не добавлены.</p>
                        {% else %}
                            <nav class="storefront-category-grid" aria-label="Категории товаров">
                                {% for category in view.categories %}
                                    <a href="{{ path(storefront_category_route, {storeSlug: store.slug, categorySlug: category.slug}) }}">
                                        <span>{{ category.name }}</span><span aria-hidden="true">→</span>
                                    </a>
                                {% endfor %}
                            </nav>
                        {% endif %}
                    </div>
                </section>
            {% elseif section == 'contacts' %}
                <section class="section storefront-contacts">
                    <div class="wrap">
                        <h2>Контакты магазина</h2>
                        <div class="store-contact-list">
                            {% if store.contactPhone %}<a href="tel:{{ store.contactPhone }}">{{ store.contactPhone }}</a>{% endif %}
                            {% if store.contactEmail %}<a href="mailto:{{ store.contactEmail }}">{{ store.contactEmail }}</a>{% endif %}
                            {% if store.contactCity or store.contactAddress %}
                                <p>{{ [store.contactCity, store.contactAddress]|filter(value => value)|join(', ') }}</p>
                            {% endif %}
                            {% if not store.contactPhone and not store.contactEmail and not store.contactCity and not store.contactAddress %}
                                <p class="muted">Контакты пока не указаны.</p>
                            {% endif %}
                        </div>
                    </div>
                </section>
            {% endif %}
        {% endfor %}
    </div>
    {% if hero_slides|length > 1 %}<script src="/assets/storefront-slider.js?v=20261013" defer></script>{% endif %}
    {% if featured_layout == 'carousel' %}<script src="/assets/storefront-carousel.js?v=20261013" defer></script>{% endif %}
{% endblock %}
