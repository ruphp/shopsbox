{% extends 'storefront/_layout.html.twig' %}

{% set store = view.store %}
{% set theme = store.themeSettings %}
{% set sections = theme.sections|default(['hero', 'featured']) %}
{% set template = theme.template|default('classic') %}
{% set primary_color = theme.primary_color|default('#0077b6') %}
{% set hero_slides = theme.hero_slides|default([]) %}
{% if hero_slides is empty %}
    {% set hero_slides = [{
        eyebrow: theme.hero_eyebrow|default(''),
        title: theme.hero_title|default('') ?: store.name,
        text: theme.hero_text|default('') ?: 'Витрина магазина открыта. Ниже первые опубликованные товары.',
        button_label: theme.hero_button_label|default('Смотреть товары'), button_url: '',
        secondary_label: '', secondary_url: '',
        alignment: theme.hero_alignment|default('left'), overlay: theme.hero_overlay|default(60),
        vertical_alignment: 'center', content_width: 'medium', image_position: 'center',
        image_url: theme.hero_image_url|default('')
    }] %}
{% endif %}
{% set first_hero_slide = hero_slides|first %}
{% set hero_image = first_hero_slide.image_url|default('') %}
{% set benefit_icon_keys = ['delivery', 'quality', 'support', 'payment', 'return', 'secure', 'gift', 'stock', 'pickup', 'custom'] %}
{% set review_avatar_keys = ['person-1', 'person-2', 'person-3', 'person-4', 'person-5', 'person-6', 'person-7', 'person-8', 'person-9', 'person-10'] %}
{% set seo_title = theme.seo_title|default('') ?: store.name %}
{% set seo_description = theme.seo_description|default('') ?: (store.publicDescription|default('') ?: 'Открытая витрина магазина ' ~ store.name ~ ' с опубликованными товарами.') %}

{% block title %}{{ seo_title }}{% endblock %}
{% block og_title %}{{ seo_title }}{% endblock %}
{% block meta_description %}{{ seo_description }}{% endblock %}
{% block og_description %}{{ seo_description }}{% endblock %}
{% block meta_robots %}{{ appearancePreview|default(false) ? 'noindex, nofollow' : 'index, follow' }}{% endblock %}
{% block og_image %}{{ hero_image ? (hero_image starts with 'http' ? hero_image : site_public_base_url ~ hero_image) : parent() }}{% endblock %}
{% block canonical_url %}{{ site_public_base_url ~ path('storefront_home', {storeSlug: store.slug}) }}{% endblock %}
{% block structured_data %}
    {% if theme.faqs|default([]) is not empty %}
        {% set faq_entities = [] %}
        {% for faq in theme.faqs %}
            {% set faq_entities = faq_entities|merge([{'@type': 'Question', name: faq.question, acceptedAnswer: {'@type': 'Answer', text: faq.answer}}]) %}
        {% endfor %}
        <script type="application/ld+json">{{ {'@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq_entities}|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
    {% endif %}
{% endblock %}

{% block storefront_content %}
    <div class="storefront-page storefront-template-{{ template }}">
        {% for section in sections %}
            {% if section == 'hero' %}
                <section class="storefront-hero-slider" data-hero-slider data-autoplay="{{ theme.hero_autoplay|default(true) ? '1' : '0' }}" data-interval="{{ theme.hero_interval|default(5) * 1000 }}" aria-label="Главные предложения">
                    <div class="storefront-hero-slides">
                        {% for slide in hero_slides %}
                            {% set slide_image = slide.image_url|default('') %}
                            {% set primary_url = slide.button_url|default('') ?: path(storefront_products_route, {storeSlug: store.slug}) %}
                            <article class="hero storefront-hero storefront-hero-slide align-{{ slide.alignment|default('left') }} vertical-{{ slide.vertical_alignment|default('center') }} content-{{ slide.content_width|default('medium') }} height-{{ slide.height|default('regular') }} tone-{{ slide.text_tone|default('auto') }} buttons-{{ slide.button_style|default('accent') }} order-{{ slide.content_order|default('text-first') }} {{ slide_image ? 'has-image' : '' }} {{ loop.first ? 'is-active' : '' }}" data-hero-slide aria-hidden="{{ loop.first ? 'false' : 'true' }}" style="--storefront-hero-overlay: {{ slide.overlay|default(60) / 100 }}; --storefront-hero-position: {{ slide.image_position|default('center') }}{% if slide_image %}; --storefront-hero-image: url('{{ slide_image }}'){% endif %}">
                                <div class="wrap">
                                    <div class="storefront-hero-content">
                                        {% if slide.eyebrow|default('') %}<p class="storefront-hero-eyebrow">{{ slide.eyebrow }}</p>{% endif %}
                                        {% if loop.first %}<h1>{{ slide.title }}</h1>{% else %}<h2>{{ slide.title }}</h2>{% endif %}
                                        {% if slide.text|default('') %}<p>{{ slide.text }}</p>{% endif %}
                                        {% if slide.button_label|default('') or slide.secondary_label|default('') %}
                                            <div class="storefront-hero-actions">
                                                {% if slide.button_label|default('') %}<a class="button" href="{{ primary_url }}">{{ slide.button_label }}</a>{% endif %}
                                                {% if slide.secondary_label|default('') and slide.secondary_url|default('') %}<a class="button button-secondary" href="{{ slide.secondary_url }}">{{ slide.secondary_label }}</a>{% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                    {% if hero_slides|length > 1 %}
                        <button class="storefront-slider-arrow is-prev" type="button" data-slider-prev aria-label="Предыдущий слайд">‹</button>
                        <button class="storefront-slider-arrow is-next" type="button" data-slider-next aria-label="Следующий слайд">›</button>
                        <div class="storefront-slider-dots" role="tablist" aria-label="Выбор слайда">
                            {% for slide in hero_slides %}<button type="button" class="{{ loop.first ? 'is-active' : '' }}" data-slider-dot="{{ loop.index0 }}" aria-label="Слайд {{ loop.index }}" aria-selected="{{ loop.first ? 'true' : 'false' }}"></button>{% endfor %}
                        </div>
                    {% endif %}
                </section>
            {% elseif section == 'featured' or section starts with 'product:' %}
                {% set product_block_id = section == 'featured' ? (view.productBlocks|first).id|default('featured') : section|slice(8) %}
                {% set product_block = view.productBlocksById[product_block_id]|default(view.productBlocks|first) %}
                {% if product_block %}
                <section class="section storefront-featured">
                    <div class="wrap">
                        <h2>{{ product_block.title }}</h2>

                        {% if product_block.products is empty %}
                            <p class="muted">Пока нет опубликованных товаров.</p>
                        {% else %}
                            <div class="storefront-product-block {{ product_block.layout == 'carousel' ? 'is-carousel' : '' }}"{% if product_block.layout == 'carousel' %} data-product-carousel data-autoplay="{{ product_block.autoplay ? '1' : '0' }}" data-interval="{{ product_block.interval * 1000 }}"{% endif %}>
                                {% if product_block.layout == 'carousel' %}<button type="button" class="product-carousel-arrow is-prev" data-carousel-prev aria-label="Показать предыдущие товары">‹</button>{% endif %}
                                <div class="product-grid storefront-product-grid columns-{{ product_block.columns }}"{% if product_block.layout == 'carousel' %} data-carousel-track tabindex="0"{% endif %}>
                                {% for product in product_block.products %}
                                    <article class="product-card">
                                        <a class="product-media" href="{{ path(storefront_product_route, {storeSlug: store.slug, productSlug: product.slug}) }}">
                                            {% if product.imageUrl %}
                                                <img src="{{ product.imageUrl }}" alt="{{ product.name }}" loading="lazy">
                                            {% else %}
                                                <span>{{ product.name }}</span>
                                            {% endif %}
                                        </a>
                                        <div class="product-card-body">
                                            <h3><a href="{{ path(storefront_product_route, {storeSlug: store.slug, productSlug: product.slug}) }}">{{ product.name }}</a></h3>
                                            {% if product_block.showDescription %}<p class="muted">{{ product.description ?: 'Описание появится позже.' }}</p>{% endif %}
                                            <p class="product-price product-price-small">{{ product.price|number_format(2, ',', ' ') }} {{ currency_symbol }}</p>
                                        </div>
                                    </article>
                                {% endfor %}
                                </div>
                                {% if product_block.layout == 'carousel' %}<button type="button" class="product-carousel-arrow is-next" data-carousel-next aria-label="Показать следующие товары">›</button>{% endif %}
                            </div>
                        {% endif %}
                    </div>
                </section>
                {% endif %}
            {% elseif section == 'categories' %}
                <section class="section storefront-categories">
                    <div class="wrap">
                        <h2>Категории</h2>
                        {% if view.categories is empty %}
                            <p class="muted">Категории пока не добавлены.</p>
                        {% else %}
                            <nav class="storefront-category-grid" aria-label="Категории товаров">
                                {% for category in view.categories %}
                                    {% set category_image = theme.category_images[category.slug]|default({}) %}
                                    <a class="{{ category_image.image_url|default('') ? 'has-image' : '' }}" href="{{ path(storefront_category_route, {storeSlug: store.slug, categorySlug: category.slug}) }}"{% if category_image.image_url|default('') %} style="--category-image: url('{{ category_image.image_url }}')"{% endif %}>
                                        <span>{{ category.name }}</span><span class="storefront-category-arrow" aria-hidden="true">→</span>
                                    </a>
                                {% endfor %}
                            </nav>
                        {% endif %}
                    </div>
                </section>
            {% elseif section == 'contacts' %}
                <section class="section storefront-contacts">
                    <div class="wrap">
                        <h2>Контакты магазина</h2>
                        <div class="store-contact-list">
                            {% if store.contactPhone %}<a href="tel:{{ store.contactPhone }}">{{ store.contactPhone }}</a>{% endif %}
                            {% if store.contactEmail %}<a href="mailto:{{ store.contactEmail }}">{{ store.contactEmail }}</a>{% endif %}
                            {% if store.contactCity or store.contactAddress %}
                                <p>{{ [store.contactCity, store.contactAddress]|filter(value => value)|join(', ') }}</p>
                            {% endif %}
                            {% if not store.contactPhone and not store.contactEmail and not store.contactCity and not store.contactAddress %}
                                <p class="muted">Контакты пока не указаны.</p>
                            {% endif %}
                        </div>
                    </div>
                </section>
            {% elseif section == 'benefits' and theme.benefits|default([]) is not empty %}
                <section class="section storefront-benefits">
                    <div class="wrap">
                        <h2>{{ theme.benefits_title|default('Почему выбирают нас') }}</h2>
                        <div class="storefront-benefit-grid">
                            {% for benefit in theme.benefits %}
                                {% set benefit_icon = benefit.icon|default('') in benefit_icon_keys ? benefit.icon : benefit_icon_keys[loop.index0 % (benefit_icon_keys|length)] %}
                                {% set benefit_url = benefit.image_url|default('/assets/system-media/benefits/' ~ benefit_icon ~ '.svg') %}
                                {% set benefit_system = benefit.media_source|default('system-benefit:' ~ benefit_icon) starts with 'system-benefit:' %}
                                <article>
                                    <span class="storefront-benefit-icon {{ benefit_system ? 'is-system' : '' }}" style="--benefit-media:url('{{ benefit_url }}');--benefit-color:{{ benefit.color|default(primary_color) }}" aria-hidden="true"><img src="{{ benefit_url }}" alt=""></span>
                                    <h3>{{ benefit.title }}</h3>
                                    {% if benefit.text %}<p>{{ benefit.text }}</p>{% endif %}
                                </article>
                            {% endfor %}
                        </div>
                    </div>
                </section>
            {% elseif section == 'content' %}
                <section class="section storefront-content-band image-{{ theme.content_image_position|default('left') }}">
                    <div class="wrap storefront-content-layout {{ theme.content_image_url|default('') ? 'has-image' : '' }}">
                        {% if theme.content_image_url|default('') %}
                            <img src="{{ theme.content_image_url }}" alt="{{ theme.content_title|default('О магазине') }}" loading="lazy">
                        {% endif %}
                        <div>
                            <h2>{{ theme.content_title|default('О магазине') }}</h2>
                            {% if theme.content_text|default('') %}<p>{{ theme.content_text|nl2br }}</p>{% endif %}
                            {% if theme.content_button_label|default('') and theme.content_button_url|default('') %}
                                <a class="button" href="{{ theme.content_button_url }}">{{ theme.content_button_label }}</a>
                            {% endif %}
                        </div>
                    </div>
                </section>
            {% elseif section == 'reviews' and theme.reviews|default([]) is not empty %}
                <section class="section storefront-reviews">
                    <div class="wrap">
                        <h2>{{ theme.reviews_title|default('Отзывы покупателей') }}</h2>
                        <div class="storefront-review-grid">
                            {% for review in theme.reviews %}
                                {% set review_avatar = review.avatar|default('') in review_avatar_keys ? review.avatar : review_avatar_keys[loop.index0 % (review_avatar_keys|length)] %}
                                <article>
                                    <div class="storefront-review-rating" aria-label="Оценка {{ review.rating }} из 5">{% for star in 1..5 %}<span class="{{ star <= review.rating ? 'is-filled' : '' }}" aria-hidden="true">★</span>{% endfor %}</div>
                                    <blockquote>{{ review.text }}</blockquote>
                                    <div class="storefront-review-author"><img class="shape-{{ review.avatar_shape|default('circle') }}" src="{{ review.avatar_url|default('/assets/system-media/people/' ~ review_avatar ~ '.jpg') }}" alt=""><strong>{{ review.author }}</strong></div>
                                </article>
                            {% endfor %}
                        </div>
                    </div>
                </section>
            {% elseif section == 'faq' and theme.faqs|default([]) is not empty %}
                <section class="section storefront-faq">
                    <div class="wrap">
                        <h2>{{ theme.faq_title|default('Частые вопросы') }}</h2>
                        <div class="storefront-faq-list">
                            {% for faq in theme.faqs %}
                                <details><summary>{{ faq.question }}</summary><div>{{ faq.answer|nl2br }}</div></details>
                            {% endfor %}
                        </div>
                    </div>
                </section>
            {% endif %}
        {% endfor %}
    </div>
    {% if hero_slides|length > 1 %}<script src="/assets/storefront-slider.js?v=20261013" defer></script>{% endif %}
    {% if view.productBlocks is not empty %}<script src="/assets/storefront-carousel.js?v=20261014-multiple" defer></script>{% endif %}
{% endblock %}
