<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}ShopsBox{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Интернет-Магазин из коробки: запуск, каталог, витрина и управление магазином на одной платформе.{% endblock %}">
        <link rel="canonical" href="{% block canonical_url %}{{ site_public_base_url ~ app.request.pathInfo }}{% endblock %}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="ShopsBox">
        <meta property="og:title" content="{% block og_title %}ShopsBox{% endblock %}">
        <meta property="og:description" content="{% block og_description %}Интернет-Магазин из коробки для быстрого запуска продаж.{% endblock %}">
        <meta property="og:url" content="{{ site_public_base_url ~ app.request.pathInfo }}">
        <meta property="og:image" content="{% block og_image %}https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1200&q=80{% endblock %}">
        <meta name="twitter:card" content="summary_large_image">
        <style>
            :root {
                color-scheme: light;
                --ink: #17211f;
                --muted: #5d6865;
                --line: #d8dfdc;
                --surface: #f5f7f6;
                --accent: #0b7669;
                --accent-dark: #074f47;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                color: var(--ink);
                background: #ffffff;
                line-height: 1.5;
            }

            a {
                color: var(--accent-dark);
                text-decoration: none;
            }

            a:hover {
                text-decoration: underline;
            }

            .page {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .header,
            .footer {
                border-bottom: 1px solid var(--line);
                background: #ffffff;
            }

            .footer {
                border-top: 1px solid var(--line);
                border-bottom: 0;
                color: var(--muted);
            }

            .wrap {
                width: min(1080px, calc(100% - 32px));
                margin: 0 auto;
            }

            .nav {
                min-height: 64px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
            }

            .brand {
                font-weight: 700;
                letter-spacing: 0;
            }

            .links {
                display: flex;
                gap: 16px;
                flex-wrap: wrap;
            }

            .main {
                flex: 1;
            }

            .hero {
                padding: 56px 0 40px;
                background: var(--surface);
                border-bottom: 1px solid var(--line);
            }

            .hero h1,
            .section h1,
            .section h2 {
                margin: 0 0 12px;
                line-height: 1.15;
            }

            .hero p,
            .muted {
                color: var(--muted);
            }

            .section {
                padding: 36px 0;
            }

            .grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 16px;
            }

            .product {
                border: 1px solid var(--line);
                border-radius: 8px;
                padding: 18px;
                min-height: 150px;
            }

            .product h2,
            .product h3 {
                margin: 0 0 8px;
            }

            .button {
                display: inline-flex;
                min-height: 40px;
                align-items: center;
                justify-content: center;
                padding: 8px 14px;
                border-radius: 8px;
                color: #ffffff;
                background: var(--accent);
                font-weight: 700;
            }

            .button:hover {
                text-decoration: none;
                background: var(--accent-dark);
            }

            .site-hero {
                min-height: 640px;
                display: flex;
                align-items: center;
                color: #ffffff;
                background:
                    linear-gradient(90deg, rgba(9, 25, 23, 0.9), rgba(9, 25, 23, 0.46)),
                    url("https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1800&q=80") center / cover;
            }

            .site-hero h1 {
                max-width: 720px;
                margin: 0 0 18px;
                font-size: 56px;
                line-height: 1.08;
            }

            .site-hero p {
                max-width: 620px;
                color: rgba(255, 255, 255, 0.86);
                font-size: 20px;
            }

            .site-band {
                padding: 56px 0;
            }

            .site-band.alt {
                background: var(--surface);
            }

            .split {
                display: grid;
                grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
                gap: 32px;
                align-items: center;
            }

            .feature-list {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 16px;
                margin-top: 24px;
            }

            .metric {
                border-left: 4px solid var(--accent);
                padding-left: 14px;
            }

            .metric strong {
                display: block;
                font-size: 30px;
            }

            .photo {
                width: 100%;
                min-height: 320px;
                object-fit: cover;
                border-radius: 8px;
            }

            @media (max-width: 720px) {
                .site-hero {
                    min-height: 560px;
                }

                .site-hero h1 {
                    font-size: 38px;
                }

                .split {
                    grid-template-columns: 1fr;
                }
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <div class="page">
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
