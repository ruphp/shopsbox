{% extends 'tenant/_owner_layout.html.twig' %}

{% block title %}Медиатека магазина | ShopsBox{% endblock %}
{% block meta_description %}Медиатека магазина ShopsBox.{% endblock %}

{% block owner_content %}
    <section class="section media-library-page">
        <div class="wrap">
            <header class="media-library-heading">
                <div>
                    <p class="eyebrow">Кабинет владельца</p>
                    <h1>Медиатека</h1>
                    <p class="muted">Изображения и файлы, используемые в товарах и оформлении витрины.</p>
                </div>
                <a class="button button-secondary" href="{{ path('owner_products') }}">Перейти к товарам</a>
            </header>

            {% if app.request.query.get('notice') %}<p class="owner-notice">{{ app.request.query.get('notice') == 'deleted' ? 'Файл удалён.' : 'Файл добавлен в медиатеку.' }}</p>{% endif %}
            {% if app.request.query.get('error') %}<p class="owner-error">{{ app.request.query.get('error') == 'used' ? 'Файл используется. Сначала отвяжите его от товаров и оформления.' : 'Не удалось обработать файл. Проверьте формат, размер и повторите.' }}</p>{% endif %}

            <form class="media-upload" method="post" enctype="multipart/form-data" action="{{ path('owner_media_upload') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('owner_media') }}">
                <div class="form-field">
                    <label for="media-file">Загрузить изображение</label>
                    <input id="media-file" type="file" name="file" accept="image/jpeg,image/png,image/webp,image/gif" required>
                    <span class="field-hint">JPG, PNG, WebP или GIF, до 5 МБ. После загрузки файл можно выбирать для разных товаров.</span>
                </div>
                <button class="button" type="submit">Загрузить</button>
            </form>

            <dl class="media-library-stats">
                <div><dt>Файлов</dt><dd>{{ library.files|length }}</dd></div>
                <div><dt>Размер выборки</dt><dd>{{ (library.totalSize / 1024 / 1024)|number_format(2, '.', ' ') }} МБ</dd></div>
                <div>
                    <dt>Хранилище</dt>
                    <dd>{{ (library.limit.usedSize / 1024 / 1024)|number_format(2, '.', ' ') }} из {{ (library.limit.maxSize / 1024 / 1024)|number_format(0, '.', ' ') }} МБ</dd>
                    <span><i style="width: {{ library.limit.sizePercent > 100 ? 100 : library.limit.sizePercent }}%"></i></span>
                </div>
            </dl>

            {% if library.limit.exceeded %}
                <p class="legal-note">Лимит файлов превышен. Новые загрузки будут отклоняться, опубликованная витрина продолжит работать.</p>
            {% elseif library.limit.nearLimit %}
                <p class="legal-note">Вы приближаетесь к лимиту файлов. Удалите лишнее или подготовьте расширение тарифа.</p>
            {% endif %}

            <nav class="media-library-filters" aria-label="Фильтр медиатеки">
                <a class="{{ currentType == '' ? 'is-active' : '' }}" href="{{ path('owner_media_library') }}">Все</a>
                <a class="{{ currentType == 'image' ? 'is-active' : '' }}" href="{{ path('owner_media_library', {type: 'image'}) }}">Изображения</a>
                <a class="{{ currentType == 'document' ? 'is-active' : '' }}" href="{{ path('owner_media_library', {type: 'document'}) }}">Документы</a>
                <a class="{{ currentType == 'video' ? 'is-active' : '' }}" href="{{ path('owner_media_library', {type: 'video'}) }}">Видео</a>
            </nav>

            {% if library.files is empty %}
                <p class="legal-note">Файлы пока не найдены.</p>
            {% else %}
                <div class="media-library-grid">
                    {% for file in library.files %}
                        <article class="media-file-card">
                            <a class="media-file-preview" href="{{ file.publicUrl }}" target="_blank" rel="noopener" aria-label="Открыть {{ file.key }}">
                                {% if file.mediaType == 'image' %}
                                    <img src="{{ file.publicUrl }}" alt="{{ file.usage }}" loading="lazy">
                                {% else %}
                                    <span>{{ file.mediaType == 'video' ? 'Видео' : 'Документ' }}</span>
                                {% endif %}
                            </a>
                            <div class="media-file-body">
                                <div class="media-file-title">
                                    <h2>{{ file.originalName ?: file.key }}</h2>
                                    <span>{{ file.mediaType == 'image' ? 'Изображение' : (file.mediaType == 'video' ? 'Видео' : 'Документ') }}</span>
                                </div>
                                <p class="media-file-name" title="{{ file.key }}">{{ file.key }}</p>
                                <p class="media-file-usage {{ file.usageCount ? '' : 'is-unused' }}">{{ file.usage }}</p>
                                <div class="media-file-meta">
                                    <span>{{ (file.size / 1024)|number_format(1, '.', ' ') }} КБ</span>
                                    <time>{{ file.createdAt|date('d.m.Y') }}</time>
                                </div>
                                <div class="media-file-actions">
                                    <a class="button button-secondary" href="{{ file.publicUrl }}" target="_blank" rel="noopener">Открыть</a>
                                    <a class="button button-secondary" href="{{ file.publicUrl }}" download>Скачать</a>
                                    {% if file.usageCount == 0 %}
                                        <form method="post" action="{{ path('owner_media_delete', {fileId: file.id}) }}" onsubmit="return confirm('Удалить файл из медиатеки?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('owner_media') }}">
                                            <button class="button button-danger" type="submit">Удалить</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}

            <aside class="media-library-note">
                <strong>Правила удаления</strong>
                <p>Файл, который используется товаром, логотипом или баннером, удалить нельзя. Неиспользуемые файлы можно удалить из медиатеки.</p>
            </aside>
        </div>
    </section>
{% endblock %}
