{% extends 'base.html.twig' %}

{% block meta_robots %}noindex, nofollow{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/owner.css?v=20261014-builder-tabs">
{% endblock %}

{% block body %}
    <header class="header owner-header responsive-header" data-responsive-header>
        <div class="wrap nav responsive-header-row">
            <a class="brand" href="{{ path('owner_dashboard') }}">Кабинет ShopsBox</a>
            <button class="responsive-menu-toggle" type="button" aria-expanded="false" aria-controls="owner-menu" aria-label="Открыть меню" data-responsive-menu-toggle><span></span><span></span><span></span></button>
            <nav class="links responsive-menu" id="owner-menu" aria-label="Навигация кабинета" data-responsive-menu>
                <a href="{{ path('owner_dashboard') }}">Обзор</a>
                <a href="{{ path('owner_products') }}">Товары</a>
                <a href="{{ path('owner_media_library') }}">Медиатека</a>
                <a href="{{ path('owner_store_publication') }}">Публикация</a>
                <a href="{{ path('owner_store_settings') }}">Настройки</a>
                <a href="{{ path('owner_store_appearance') }}">Оформление</a>
                <a href="{{ path('owner_orders') }}">Заказы</a>
                <a href="{{ path('storefront_home', {storeSlug: settings.slug}) }}">Витрина</a>
                <form class="nav-form" method="post" action="{{ path('auth_logout') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
                    <button type="submit">Выйти</button>
                </form>
            </nav>
        </div>
    </header>

    <main class="main">
        {% block owner_content %}{% endblock %}
    </main>
{% endblock %}
