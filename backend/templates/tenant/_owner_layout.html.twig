{% extends 'base.html.twig' %}

{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body %}
    <header class="header">
        <div class="wrap nav">
            <a class="brand" href="{{ path('owner_dashboard') }}">Кабинет ShopsBox</a>
            <nav class="links" aria-label="Навигация кабинета">
                <a href="{{ path('owner_dashboard') }}">Обзор</a>
                <a href="{{ path('admin_catalog_products_list', {tenantId: settings.tenantId, storeId: settings.storeId}) }}">Товары</a>
                <a href="{{ path('owner_media_library') }}">Медиатека</a>
                <a href="{{ path('owner_store_publication') }}">Публикация</a>
                <a href="{{ path('owner_store_settings') }}">Настройки</a>
                <a href="{{ path('owner_orders') }}">Заказы</a>
                <a href="{{ path('storefront_home', {storeSlug: settings.slug}) }}">Preview</a>
                <form class="nav-form" method="post" action="{{ path('auth_logout') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
                    <button type="submit">Выйти</button>
                </form>
            </nav>
        </div>
    </header>

    <main class="main">
        {% block owner_content %}{% endblock %}
    </main>
{% endblock %}
