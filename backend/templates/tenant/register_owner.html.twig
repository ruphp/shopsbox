{% extends 'base.html.twig' %}

{% block title %}Регистрация владельца магазина | ShopsBox{% endblock %}
{% block meta_description %}Регистрация владельца и создание первого магазина ShopsBox.{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}

    <main class="main">
        <section class="section">
            <div class="wrap">
                <p class="eyebrow">Первый магазин</p>
                <h1>Зарегистрировать владельца</h1>
                <p class="muted">Телефон подтвержден: {{ phone }}. Заполните данные владельца и первого магазина.</p>

                {% if error is defined %}
                    <p class="legal-note">{{ error }}</p>
                {% endif %}

                <form class="legal-note" method="post" action="{{ path('owner_register_submit') }}">
                    <p class="form-field">
                        <label for="owner-name">ФИО владельца</label>
                        <input id="owner-name" name="owner_name" type="text" value="{{ ownerName|default('') }}" required>
                    </p>
                    <p class="form-field">
                        <label for="owner-email">Email</label>
                        <input id="owner-email" name="email" type="email" value="{{ email|default('') }}" required>
                    </p>
                    <p class="form-field">
                        <label for="store-name">Название магазина</label>
                        <input id="store-name" name="store_name" type="text" value="{{ storeName|default('') }}" required>
                    </p>
                    <p class="form-field">
                        <label for="store-slug">Логин для поддомена</label>
                        <input id="store-slug" name="store_slug" type="text" value="{{ storeSlug|default('') }}" placeholder="my-market" required>
                        <small class="field-hint">Этот логин будет использоваться в адресе магазина: my-market.shopsbox.ru.</small>
                    </p>
                    <p class="form-field">
                        <label for="timezone">Часовой пояс</label>
                        {% set selectedTimezone = timezone|default('+05:00') %}
                        <select id="timezone" name="timezone" required>
                            <option value="+02:00" {{ selectedTimezone == '+02:00' ? 'selected' : '' }}>UTC+2</option>
                            <option value="+03:00" {{ selectedTimezone == '+03:00' ? 'selected' : '' }}>UTC+3</option>
                            <option value="+04:00" {{ selectedTimezone == '+04:00' ? 'selected' : '' }}>UTC+4</option>
                            <option value="+05:00" {{ selectedTimezone == '+05:00' ? 'selected' : '' }}>UTC+5</option>
                            <option value="+06:00" {{ selectedTimezone == '+06:00' ? 'selected' : '' }}>UTC+6</option>
                            <option value="+07:00" {{ selectedTimezone == '+07:00' ? 'selected' : '' }}>UTC+7</option>
                            <option value="+08:00" {{ selectedTimezone == '+08:00' ? 'selected' : '' }}>UTC+8</option>
                            <option value="+09:00" {{ selectedTimezone == '+09:00' ? 'selected' : '' }}>UTC+9</option>
                            <option value="+10:00" {{ selectedTimezone == '+10:00' ? 'selected' : '' }}>UTC+10</option>
                            <option value="+11:00" {{ selectedTimezone == '+11:00' ? 'selected' : '' }}>UTC+11</option>
                            <option value="+12:00" {{ selectedTimezone == '+12:00' ? 'selected' : '' }}>UTC+12</option>
                        </select>
                    </p>
                    <p>
                        <label>
                            <input type="checkbox" name="terms" value="1" required>
                            Я согласен с условиями <a href="{{ path('site_static', {page: 'terms'}) }}" target="_blank" rel="noopener">Пользовательского соглашения</a> и <a href="{{ path('site_static', {page: 'privacy'}) }}" target="_blank" rel="noopener">Политикой конфиденциальности</a>.
                        </label>
                    </p>
                    <button class="button" type="submit">Создать магазин</button>
                </form>
            </div>
        </section>
    </main>

    {% include 'site/_footer.html.twig' %}
{% endblock %}
