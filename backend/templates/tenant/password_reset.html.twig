{% extends 'base.html.twig' %}

{% block title %}Новый пароль | ShopsBox{% endblock %}
{% block meta_description %}Установка нового пароля ShopsBox.{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main class="main">
        <section class="section">
            <div class="wrap auth-page">
                <p class="eyebrow">Восстановление доступа</p>
                <h1>Задайте новый пароль</h1>
                {% if error is defined %}<p class="legal-note auth-message" role="alert">{{ error }}</p>{% endif %}
                <form class="legal-note auth-card" method="post" action="{{ path('auth_password_reset_submit') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('password_reset') }}">
                    <p class="form-field">
                        <label for="reset-password">Новый пароль</label>
                        <input id="reset-password" name="password" type="password" minlength="10" maxlength="128" autocomplete="new-password" required autofocus>
                        <small class="field-hint">От 10 символов, минимум одна буква и одна цифра.</small>
                    </p>
                    <p class="form-field">
                        <label for="reset-password-confirmation">Повторите пароль</label>
                        <input id="reset-password-confirmation" name="password_confirmation" type="password" minlength="10" maxlength="128" autocomplete="new-password" required>
                    </p>
                    <button class="button" type="submit">Сохранить пароль</button>
                </form>
            </div>
        </section>
    </main>
    {% include 'site/_footer.html.twig' %}
{% endblock %}
