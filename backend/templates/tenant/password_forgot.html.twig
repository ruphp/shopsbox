{% extends 'base.html.twig' %}

{% block title %}Восстановление пароля | ShopsBox{% endblock %}
{% block meta_description %}Восстановление доступа к кабинету ShopsBox.{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main class="main">
        <section class="section">
            <div class="wrap auth-page">
                <p class="eyebrow">Восстановление доступа</p>
                <h1>Сбросить пароль</h1>
                <p class="muted">Получите одноразовый код на email, указанный при регистрации.</p>
                {% for message in app.flashes('auth_code') %}<p class="legal-note auth-message">{{ message }}</p>{% endfor %}
                {% if error is defined %}<p class="legal-note auth-message" role="alert">{{ error }}</p>{% endif %}

                {% if requested is defined and requested %}
                    <form class="legal-note auth-card" method="post" action="{{ path('auth_password_verify') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('password_verify') }}">
                        <input type="hidden" name="email" value="{{ email }}">
                        <p>Код отправлен на {{ email }}{% if expiresAt is defined %}. Он действует до {{ expiresAt|date('H:i') }}{% endif %}.</p>
                        <p class="form-field">
                            <label for="reset-code">Код из письма</label>
                            <input id="reset-code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" required autofocus>
                        </p>
                        <button class="button" type="submit">Проверить код</button>
                    </form>
                {% else %}
                    <form class="legal-note auth-card" method="post" action="{{ path('auth_password_forgot_request') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('password_forgot') }}">
                        <p class="form-field">
                            <label for="forgot-email">Email</label>
                            <input id="forgot-email" name="email" type="email" value="{{ email|default('') }}" autocomplete="email" required autofocus>
                        </p>
                        <div class="auth-actions">
                            <button class="button" type="submit">Получить код</button>
                            <a href="{{ path('auth_login_form') }}">Вернуться ко входу</a>
                        </div>
                    </form>
                {% endif %}
            </div>
        </section>
    </main>
    {% include 'site/_footer.html.twig' %}
{% endblock %}
