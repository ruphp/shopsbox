{% extends 'tenant/_owner_layout.html.twig' %}

{% block title %}Оформление витрины | ShopsBox{% endblock %}
{% block meta_description %}Настройка внешнего вида витрины магазина ShopsBox.{% endblock %}

{% block owner_content %}
    {% set theme = appearanceTheme|default(settings.themeSettings) %}
    {% set template = theme.template|default('classic') %}
    {% set primaryColor = theme.primary_color|default('#0077b6') %}
    {% set sections = theme.sections|default(['hero', 'featured']) %}
    {% set logoImageId = theme.logo_image_id|default('') %}
    {% set showStoreNameWithLogo = theme.show_store_name_with_logo|default(false) %}
    {% set heroImageId = theme.hero_image_id|default('') %}
    {% set heroSlides = theme.hero_slides|default([]) %}
    {% if heroSlides is empty %}
        {% set heroSlides = [{
            eyebrow: theme.hero_eyebrow|default(''),
            title: theme.hero_title|default('') ?: settings.name,
            text: theme.hero_text|default(''),
            button_label: theme.hero_button_label|default('Смотреть товары'),
            button_url: '', secondary_label: '', secondary_url: '',
            alignment: theme.hero_alignment|default('left'),
            overlay: theme.hero_overlay|default(60),
            image_id: heroImageId,
            image_url: theme.hero_image_url|default('')
        }] %}
    {% endif %}
    {% set firstHeroSlide = heroSlides|first %}
    {% set heroImageId = firstHeroSlide.image_id|default('') %}
    {% set heroAlignment = firstHeroSlide.alignment|default('left') %}
    {% set heroOverlay = firstHeroSlide.overlay|default(60) %}
    {% set featuredColumns = theme.featured_columns|default(4) %}
    {% set featuredShowDescription = theme.featured_show_description|default(true) %}
    {% set featuredSource = theme.featured_source|default('latest') %}
    {% set featuredProductIds = theme.featured_product_ids|default([]) %}
    {% set categoryImages = theme.category_images|default({}) %}
    {% set benefits = theme.benefits|default([]) %}
    {% if benefits is empty %}{% set benefits = [{title: '', text: ''}, {title: '', text: ''}, {title: '', text: ''}] %}{% endif %}
    {% set reviews = theme.reviews|default([]) %}
    {% set faqs = theme.faqs|default([]) %}
    {% set sectionLabels = {'hero': 'Главный блок', 'categories': 'Категории', 'featured': 'Товары', 'benefits': 'Преимущества', 'content': 'Текст и изображение', 'reviews': 'Отзывы', 'faq': 'Частые вопросы', 'contacts': 'Контакты'} %}
    {% set sectionPositions = {} %}
    {% for enabledSection in sections %}
        {% set sectionPositions = sectionPositions|merge({(enabledSection): loop.index}) %}
    {% endfor %}

    <section class="section appearance-page" data-appearance-editor>
        <div class="wrap">
            <header class="appearance-heading">
                <div>
                    <p class="eyebrow">Внешний вид</p>
                    <h1>Оформление витрины</h1>
                    <p class="muted">Настройте главную страницу магазина и сразу посмотрите результат.</p>
                </div>
                <div class="appearance-heading-actions">
                    {% if hasAppearanceDraft|default(false) %}<a class="button" href="{{ path('owner_store_appearance_preview') }}">Предпросмотр черновика</a>{% endif %}
                    <a class="button button-secondary" href="{{ path('storefront_home', {storeSlug: settings.slug}) }}">Открыть опубликованную витрину</a>
                </div>
            </header>

            {% if error is defined %}<p class="appearance-message is-error" role="alert">{{ error }}</p>{% endif %}
            {% if draftSaved|default(false) %}<p class="appearance-message is-success">Черновик сохранён. Покупатели пока видят прежнее оформление.</p>{% endif %}
            {% if published|default(false) %}<p class="appearance-message is-success">Оформление опубликовано и уже применяется на витрине.</p>{% endif %}
            {% if previewMissing|default(false) %}<p class="appearance-message is-error">Сначала сохраните оформление как черновик.</p>{% endif %}
            {% if hasAppearanceDraft|default(false) and not draftSaved|default(false) %}<p class="appearance-message">Открыт сохранённый черновик. Изменения попадут на витрину только после публикации.</p>{% endif %}

            <form class="appearance-layout" method="post" action="{{ path('owner_store_appearance_update') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('store_appearance') }}">

                <div class="appearance-controls">
                    <fieldset class="appearance-group">
                        <legend>Шаблон</legend>
                        <div class="template-options">
                            <label class="template-option">
                                <input type="radio" name="template" value="classic" {{ template == 'classic' ? 'checked' : '' }}>
                                <span><strong>Классический</strong><small>Ровная спокойная подача</small></span>
                            </label>
                            <label class="template-option">
                                <input type="radio" name="template" value="catalog" {{ template == 'catalog' ? 'checked' : '' }}>
                                <span><strong>Каталог</strong><small>Товары ближе к началу</small></span>
                            </label>
                            <label class="template-option">
                                <input type="radio" name="template" value="accent" {{ template == 'accent' ? 'checked' : '' }}>
                                <span><strong>Акцентный</strong><small>Выразительный главный блок</small></span>
                            </label>
                        </div>
                    </fieldset>

                    <fieldset class="appearance-group">
                        <legend>Категории на главной</legend>
                        <p class="field-hint">Назначьте обложки категориям. Файл останется защищённым от удаления, пока используется на витрине.</p>
                        {% if categories is empty %}
                            <p class="muted">Категории появятся здесь после добавления товаров с категориями.</p>
                        {% elseif mediaImages is empty %}
                            <p class="muted">Сначала загрузите изображения в медиатеку.</p>
                        {% else %}
                            <div class="category-image-settings">
                                {% for category in categories %}
                                    {% set selectedCategoryImage = categoryImages[category.slug]|default({}) %}
                                    <label class="category-image-setting">
                                        <strong>{{ category.name }}</strong>
                                        <select name="category_image_ids[{{ category.slug }}]" data-category-image-select data-category-slug="{{ category.slug }}">
                                            <option value="" data-image-url="">Без изображения</option>
                                            {% for image in mediaImages %}
                                                <option value="{{ image.id }}" data-image-url="{{ image.publicUrl }}" {{ selectedCategoryImage.image_id|default('') == image.id ? 'selected' : '' }}>{{ image.originalName ?: image.key }}</option>
                                            {% endfor %}
                                        </select>
                                        <span class="category-image-thumb" data-category-image-thumb {{ selectedCategoryImage.image_url|default('') ? '' : 'hidden' }}>
                                            <img src="{{ selectedCategoryImage.image_url|default('') }}" alt="" loading="lazy">
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </fieldset>

                    <fieldset class="appearance-group">
                        <legend>Основной цвет</legend>
                        <div class="color-options">
                            {% for color, label in {'#0077b6': 'Синий', '#16876b': 'Зелёный', '#d1492e': 'Красный', '#6d4bb8': 'Фиолетовый'} %}
                                <label class="color-option" title="{{ label }}">
                                    <input type="radio" name="primary_color" value="{{ color }}" {{ primaryColor == color ? 'checked' : '' }}>
                                    <span style="--swatch: {{ color }}"></span>
                                    <small>{{ label }}</small>
                                </label>
                            {% endfor %}
                        </div>
                    </fieldset>

                    <fieldset class="appearance-group">
                        <legend>Логотип</legend>
                        {% if mediaImages is empty %}
                            <p class="muted">В медиатеке пока нет изображений.</p>
                            <a href="{{ path('owner_products') }}">Загрузить изображения к товарам</a>
                        {% else %}
                            <div class="media-picker">
                                <h3>Логотип</h3>
                                <p class="field-hint">Лучше использовать компактное изображение на светлом фоне.</p>
                                <div class="media-options" role="radiogroup" aria-label="Логотип магазина">
                                    <label class="media-option media-option-none">
                                        <input type="radio" name="logo_image_id" value="" data-image-url="" {{ logoImageId == '' ? 'checked' : '' }}>
                                        <span>Без логотипа</span>
                                    </label>
                                    {% for image in mediaImages|slice(0, 12) %}
                                        <label class="media-option" title="{{ image.usage }}">
                                            <input type="radio" name="logo_image_id" value="{{ image.id }}" data-image-url="{{ image.publicUrl }}" {{ logoImageId == image.id ? 'checked' : '' }}>
                                            <span><img src="{{ image.publicUrl }}" alt="" loading="lazy"></span>
                                        </label>
                                    {% endfor %}
                                </div>
                                <label class="active-check">
                                    <input type="checkbox" name="show_store_name_with_logo" value="1" {{ showStoreNameWithLogo ? 'checked' : '' }}>
                                    Показывать название магазина рядом с логотипом
                                </label>
                            </div>

                        {% endif %}
                    </fieldset>

                    <fieldset class="appearance-group">
                        <legend>Баннеры</legend>
                        <p class="field-hint">Первый слайд содержит единственный H1 страницы. Остальные заголовки выводятся как H2, чтобы сохранить правильную SEO-структуру.</p>
                        <div class="appearance-slider-settings">
                            <label class="active-check">
                                <input type="checkbox" name="hero_autoplay" value="1" {{ theme.hero_autoplay|default(true) ? 'checked' : '' }}>
                                Переключать слайды автоматически
                            </label>
                            <label class="appearance-field">
                                <span>Интервал</span>
                                <select name="hero_interval">
                                    {% for seconds in [3, 5, 7, 10] %}<option value="{{ seconds }}" {{ theme.hero_interval|default(5) == seconds ? 'selected' : '' }}>{{ seconds }} сек.</option>{% endfor %}
                                </select>
                            </label>
                        </div>
                        <div class="appearance-slides" data-hero-slides>
                            {% for slide in heroSlides %}
                                {% include 'tenant/_appearance_slide.html.twig' with {slide: slide, index: loop.index0, mediaImages: mediaImages} only %}
                            {% endfor %}
                        </div>
                        <button class="button button-secondary" type="button" data-slide-add>Добавить слайд</button>
                        <template data-slide-template>
                            {% include 'tenant/_appearance_slide.html.twig' with {slide: {title: settings.name}, index: 0, mediaImages: mediaImages} only %}
                        </template>
                    </fieldset>

                    <fieldset class="appearance-group">
                        <legend>Товары на главной</legend>
                        <label class="appearance-field" for="featured-source">
                            <span>Какие товары показывать</span>
                            <select id="featured-source" name="featured_source" data-featured-source>
                                <option value="latest" {{ featuredSource == 'latest' ? 'selected' : '' }}>Новинки</option>
                                <option value="popular" {{ featuredSource == 'popular' ? 'selected' : '' }}>Популярные по просмотрам</option>
                                <option value="category" {{ featuredSource == 'category' ? 'selected' : '' }}>Из категории</option>
                                <option value="manual" {{ featuredSource == 'manual' ? 'selected' : '' }}>Выбрать вручную</option>
                            </select>
                        </label>
                        <div data-featured-source-panel="category" {{ featuredSource != 'category' ? 'hidden' : '' }}>
                            <label class="appearance-field" for="featured-category">
                                <span>Категория</span>
                                <select id="featured-category" name="featured_category_slug">
                                    <option value="">Выберите категорию</option>
                                    {% for category in categories %}<option value="{{ category.slug }}" {{ theme.featured_category_slug|default('') == category.slug ? 'selected' : '' }}>{{ category.name }}</option>{% endfor %}
                                </select>
                            </label>
                        </div>
                        <div class="featured-product-picker" data-featured-source-panel="manual" {{ featuredSource != 'manual' ? 'hidden' : '' }}>
                            <span>Товары и порядок</span>
                            <p class="field-hint">Отметьте товары. На витрине они появятся в порядке этого списка.</p>
                            {% for product in products %}
                                <label>
                                    <input type="checkbox" name="featured_product_ids[]" value="{{ product.id }}" {{ product.id in featuredProductIds ? 'checked' : '' }}>
                                    <span>{{ product.name }}</span>
                                    <small>{{ product.price|number_format(2, ',', ' ') }} ₽</small>
                                </label>
                            {% else %}
                                <p class="muted">Сначала добавьте товары.</p>
                            {% endfor %}
                        </div>
                        <label class="appearance-field" for="featured-title">
                            <span>Заголовок блока</span>
                            <input id="featured-title" name="featured_title" type="text" maxlength="80" value="{{ theme.featured_title|default('Популярное') }}">
                        </label>
                        <label class="appearance-field" for="featured-columns">
                            <span>Колонок на большом экране</span>
                            <select id="featured-columns" name="featured_columns">
                                {% for columns in [3, 4, 5] %}<option value="{{ columns }}" {{ featuredColumns == columns ? 'selected' : '' }}>{{ columns }}</option>{% endfor %}
                            </select>
                        </label>
                        <div class="appearance-field-row">
                            <label class="appearance-field" for="featured-layout">
                                <span>Отображение</span>
                                <select id="featured-layout" name="featured_layout">
                                    <option value="grid" {{ theme.featured_layout|default('grid') == 'grid' ? 'selected' : '' }}>Сетка</option>
                                    <option value="carousel" {{ theme.featured_layout|default('grid') == 'carousel' ? 'selected' : '' }}>Карусель</option>
                                </select>
                            </label>
                            <label class="appearance-field" for="featured-limit">
                                <span>Количество товаров</span>
                                <select id="featured-limit" name="featured_limit">
                                    {% for limit in [4, 6, 8, 10, 12] %}<option value="{{ limit }}" {{ theme.featured_limit|default(6) == limit ? 'selected' : '' }}>{{ limit }}</option>{% endfor %}
                                </select>
                            </label>
                        </div>
                        <label class="active-check">
                            <input type="checkbox" name="featured_show_description" value="1" {{ featuredShowDescription ? 'checked' : '' }}>
                            Показывать краткое описание товара
                        </label>
                    </fieldset>

                    <fieldset class="appearance-group">
                        <legend>Преимущества</legend>
                        <p class="field-hint">Коротко объясните покупателю, почему стоит заказать именно у вас. Пустые пункты не выводятся.</p>
                        <label class="appearance-field">
                            <span>Заголовок блока</span>
                            <input name="benefits_title" type="text" maxlength="80" value="{{ theme.benefits_title|default('Почему выбирают нас') }}">
                        </label>
                        <div class="benefit-settings">
                            {% for index in 0..5 %}
                                {% set benefit = benefits[index]|default({}) %}
                                <div class="benefit-setting">
                                    <strong>Пункт {{ index + 1 }}</strong>
                                    <input name="benefits[{{ index }}][title]" type="text" maxlength="60" value="{{ benefit.title|default('') }}" placeholder="Например, быстрая доставка">
                                    <textarea name="benefits[{{ index }}][text]" maxlength="240" rows="2" placeholder="Короткое пояснение">{{ benefit.text|default('') }}</textarea>
                                </div>
                            {% endfor %}
                        </div>
                    </fieldset>

                    <fieldset class="appearance-group">
                        <legend>Текст и изображение</legend>
                        <p class="field-hint">Подходит для рассказа о магазине, производстве, доставке или отдельном предложении.</p>
                        <label class="appearance-field">
                            <span>Заголовок</span>
                            <input name="content_title" type="text" maxlength="120" value="{{ theme.content_title|default('О магазине') }}">
                        </label>
                        <label class="appearance-field">
                            <span>Текст</span>
                            <textarea name="content_text" maxlength="1500" rows="5">{{ theme.content_text|default('') }}</textarea>
                        </label>
                        <div class="appearance-field-row">
                            <label class="appearance-field">
                                <span>Изображение</span>
                                <select name="content_image_id" data-content-image-select>
                                    <option value="" data-image-url="">Без изображения</option>
                                    {% for image in mediaImages %}
                                        <option value="{{ image.id }}" data-image-url="{{ image.publicUrl }}" {{ theme.content_image_id|default('') == image.id ? 'selected' : '' }}>{{ image.originalName ?: image.key }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <label class="appearance-field">
                                <span>Расположение изображения</span>
                                <select name="content_image_position">
                                    <option value="left" {{ theme.content_image_position|default('left') == 'left' ? 'selected' : '' }}>Слева</option>
                                    <option value="right" {{ theme.content_image_position|default('left') == 'right' ? 'selected' : '' }}>Справа</option>
                                </select>
                            </label>
                        </div>
                        <span class="content-image-thumb" data-content-image-thumb {{ theme.content_image_url|default('') ? '' : 'hidden' }}>
                            <img src="{{ theme.content_image_url|default('') }}" alt="" loading="lazy">
                        </span>
                        <div class="appearance-field-row">
                            <label class="appearance-field">
                                <span>Текст кнопки</span>
                                <input name="content_button_label" type="text" maxlength="40" value="{{ theme.content_button_label|default('') }}" placeholder="Подробнее">
                            </label>
                            <label class="appearance-field">
                                <span>Ссылка кнопки</span>
                                <input name="content_button_url" type="text" maxlength="500" value="{{ theme.content_button_url|default('') }}" placeholder="/s/магазин/products или https://">
                            </label>
                        </div>
                    </fieldset>

                    <fieldset class="appearance-group">
                        <legend>Отзывы</legend>
                        <p class="field-hint">Добавляйте только реальные отзывы, которые можно подтвердить при необходимости.</p>
                        <label class="appearance-field"><span>Заголовок блока</span><input name="reviews_title" type="text" maxlength="80" value="{{ theme.reviews_title|default('Отзывы покупателей') }}"></label>
                        <div class="editor-item-list">
                            {% for index in 0..5 %}
                                {% set review = reviews[index]|default({}) %}
                                <div class="editor-item">
                                    <strong>Отзыв {{ index + 1 }}</strong>
                                    <input name="reviews[{{ index }}][author]" type="text" maxlength="80" value="{{ review.author|default('') }}" placeholder="Имя покупателя">
                                    <textarea name="reviews[{{ index }}][text]" maxlength="600" rows="3" placeholder="Текст отзыва">{{ review.text|default('') }}</textarea>
                                    <label><span>Оценка</span><select name="reviews[{{ index }}][rating]">{% for rating in 5..1 %}<option value="{{ rating }}" {{ review.rating|default(5) == rating ? 'selected' : '' }}>{{ rating }} из 5</option>{% endfor %}</select></label>
                                </div>
                            {% endfor %}
                        </div>
                    </fieldset>

                    <fieldset class="appearance-group">
                        <legend>Частые вопросы</legend>
                        <p class="field-hint">Ответы выводятся раскрывающимся списком и получают SEO-разметку FAQPage.</p>
                        <label class="appearance-field"><span>Заголовок блока</span><input name="faq_title" type="text" maxlength="80" value="{{ theme.faq_title|default('Частые вопросы') }}"></label>
                        <div class="editor-item-list">
                            {% for index in 0..7 %}
                                {% set faq = faqs[index]|default({}) %}
                                <div class="editor-item">
                                    <strong>Вопрос {{ index + 1 }}</strong>
                                    <input name="faqs[{{ index }}][question]" type="text" maxlength="180" value="{{ faq.question|default('') }}" placeholder="Вопрос покупателя">
                                    <textarea name="faqs[{{ index }}][answer]" maxlength="1000" rows="3" placeholder="Ответ">{{ faq.answer|default('') }}</textarea>
                                </div>
                            {% endfor %}
                        </div>
                    </fieldset>

                    <fieldset class="appearance-group">
                        <legend>Блоки на главной</legend>
                        <p class="field-hint">Включите нужные блоки и задайте их порядок.</p>
                        <div class="section-options">
                            {% for section in ['hero', 'categories', 'featured', 'benefits', 'content', 'reviews', 'faq', 'contacts'] %}
                                {% set position = sectionPositions[section]|default(loop.index) %}
                                <div class="section-option" data-section-control="{{ section }}">
                                    <span class="section-drag-handle" draggable="true" title="Перетащить блок" aria-label="Перетащить блок">↕</span>
                                    <label>
                                        {% if section == 'hero' %}
                                            <input type="hidden" name="enabled_sections[]" value="hero">
                                            <input type="checkbox" value="hero" checked disabled>
                                        {% else %}
                                            <input type="checkbox" name="enabled_sections[]" value="{{ section }}" {{ section in sections ? 'checked' : '' }}>
                                        {% endif %}
                                        <span>{{ sectionLabels[section] }}</span>
                                    </label>
                                    <select class="section-position" name="section_positions[{{ section }}]" aria-label="Порядок блока {{ sectionLabels[section] }}">
                                        {% for number in 1..8 %}<option value="{{ number }}" {{ position == number ? 'selected' : '' }}>{{ number }}</option>{% endfor %}
                                    </select>
                                    <button type="button" class="icon-button" data-section-up aria-label="Переместить {{ sectionLabels[section] }} выше">↑</button>
                                    <button type="button" class="icon-button" data-section-down aria-label="Переместить {{ sectionLabels[section] }} ниже">↓</button>
                                </div>
                            {% endfor %}
                        </div>
                    </fieldset>

                    <fieldset class="appearance-group">
                        <legend>SEO главной страницы</legend>
                        <p class="field-hint">Если оставить поля пустыми, ShopsBox подставит название и описание магазина. Адрес страницы и canonical формируются автоматически.</p>
                        <label class="appearance-field" for="seo-title">
                            <span>Заголовок для поиска</span>
                            <input id="seo-title" name="seo_title" type="text" maxlength="70" value="{{ theme.seo_title|default('') }}" placeholder="{{ settings.name }}">
                            <small class="field-hint">Желательно до 60–70 символов.</small>
                        </label>
                        <label class="appearance-field" for="seo-description">
                            <span>Описание для поиска</span>
                            <textarea id="seo-description" name="seo_description" rows="3" maxlength="180" placeholder="Кратко опишите ассортимент и преимущества магазина">{{ theme.seo_description|default('') }}</textarea>
                            <small class="field-hint">Обычно достаточно 120–160 символов.</small>
                        </label>
                    </fieldset>

                    <div class="appearance-actions">
                        <button class="button button-secondary" type="submit" name="appearance_action" value="draft">Сохранить черновик</button>
                        <button class="button" type="submit" name="appearance_action" value="publish">Опубликовать оформление</button>
                        <a href="{{ path('owner_dashboard') }}">Вернуться к плану запуска</a>
                    </div>
                </div>

                <aside class="appearance-preview-wrap" aria-label="Предварительный просмотр">
                    <div class="appearance-preview-toolbar">
                        <strong>Предпросмотр</strong>
                        <span>Главная страница</span>
                    </div>
                    <div class="appearance-preview template-{{ template }}" style="--preview-accent: {{ primaryColor }}" data-appearance-preview>
                        <header>
                            <div class="preview-brand">
                                <img data-preview-logo src="{{ theme.logo_image_url|default('') }}" alt="" {{ logoImageId == '' ? 'hidden' : '' }}>
                                <strong data-preview-store-name {{ logoImageId != '' and not showStoreNameWithLogo ? 'hidden' : '' }}>{{ settings.name }}</strong>
                            </div>
                            <span>Товары&nbsp;&nbsp; Корзина</span>
                        </header>
                        <div class="preview-section preview-hero align-{{ heroAlignment }} {{ heroImageId != '' ? 'has-image' : '' }}" data-preview-section="hero" style="--preview-overlay: {{ heroOverlay / 100 }}{% if heroImageId != '' %}; --preview-image: url('{{ firstHeroSlide.image_url|default('') }}'){% endif %}">
                            <small class="preview-eyebrow" data-preview-eyebrow {{ firstHeroSlide.eyebrow|default('') == '' ? 'hidden' : '' }}>{{ firstHeroSlide.eyebrow|default('') }}</small>
                            <h2 data-preview-title>{{ firstHeroSlide.title|default(settings.name) }}</h2>
                            <p data-preview-text>{{ firstHeroSlide.text|default('') ?: 'Описание вашего магазина и его главного предложения.' }}</p>
                            <span class="preview-button" data-preview-button>{{ firstHeroSlide.button_label|default('Смотреть товары') }}</span>
                        </div>
                        <div class="preview-section preview-products" data-preview-section="featured">
                            <h3 data-preview-featured-title>{{ theme.featured_title|default('Популярное') }}</h3>
                            <div class="{{ theme.featured_layout|default('grid') == 'carousel' ? 'is-carousel' : '' }}" data-preview-product-grid style="--preview-columns: {{ featuredColumns }}">{% for item in 1..featuredColumns %}<i></i>{% endfor %}</div>
                        </div>
                        <div class="preview-section preview-categories" data-preview-section="categories">
                            <h3>Категории</h3>
                            <div>{% for category in categories|slice(0, 4) %}<span>{{ category.name }}</span>{% endfor %}</div>
                        </div>
                        <div class="preview-section preview-contacts" data-preview-section="contacts">
                            <h3>Контакты магазина</h3>
                            <div class="store-contact-list">
                                {% if settings.contactPhone %}<span>{{ settings.contactPhone }}</span>{% endif %}
                                {% if settings.contactEmail %}<span>{{ settings.contactEmail }}</span>{% endif %}
                                {% if settings.contactCity or settings.contactAddress %}
                                    <p>{{ [settings.contactCity, settings.contactAddress]|filter(value => value)|join(', ') }}</p>
                                {% endif %}
                                {% if not settings.contactPhone and not settings.contactEmail and not settings.contactCity and not settings.contactAddress %}
                                    <p>Контакты пока не указаны.</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </aside>
            </form>
        </div>
    </section>

    <script src="/assets/store-appearance.js?v=20261013-builder-foundation" defer></script>
{% endblock %}
