{% extends 'base.html.twig' %}

{% block title %}Вход в кабинет | ShopsBox{% endblock %}
{% block meta_description %}Вход в кабинет ShopsBox по email и паролю.{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main class="main">
        <section class="section">
            <div class="wrap auth-page">
                <p class="eyebrow">Личный кабинет</p>
                <h1>Вход в ShopsBox</h1>
                <p class="muted">Используйте email и пароль, указанные при регистрации.</p>
                {% for message in app.flashes('password_success') %}<p class="legal-note auth-message">{{ message }}</p>{% endfor %}
                {% if error is defined %}<p class="legal-note auth-message" role="alert">{{ error }}</p>{% endif %}
                <form class="legal-note auth-card" method="post" action="{{ path('auth_login_submit') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('password_login') }}">
                    <p class="form-field">
                        <label for="login-email">Email</label>
                        <input id="login-email" name="email" type="email" value="{{ email|default('') }}" autocomplete="username" required autofocus>
                    </p>
                    <p class="form-field">
                        <label for="login-password">Пароль</label>
                        <input id="login-password" name="password" type="password" autocomplete="current-password" required>
                    </p>
                    <div class="auth-actions">
                        <button class="button" type="submit">Войти</button>
                        <a href="{{ path('auth_password_forgot') }}">Забыли пароль?</a>
                    </div>
                </form>
            </div>
        </section>
    </main>
    {% include 'site/_footer.html.twig' %}
{% endblock %}
