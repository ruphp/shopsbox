{% extends 'base.html.twig' %}

{% block title %}Вход в ShopsBox по коду{% endblock %}
{% block meta_description %}Вход владельца магазина ShopsBox по одноразовому коду.{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}

    <main class="main">
        <section class="section">
            <div class="wrap">
                <p class="eyebrow">Вход в кабинет</p>
                <h1>Войти по одноразовому коду</h1>
                <p class="muted">Выберите, куда отправить код. По умолчанию используется email. В dev-режиме телефонный код показывается временным flash-сообщением.</p>

                {% if phoneRequired is defined and phoneRequired %}
                    <p class="legal-note">Для создания или публикации магазина сначала подтвердите телефон.</p>
                {% endif %}

                {% for message in app.flashes('auth_code') %}
                    <p class="legal-note">{{ message }}</p>
                {% endfor %}

                {% if error is defined %}
                    <p class="legal-note">{{ error }}</p>
                {% endif %}

                {% if verified is defined and verified %}
                    <div class="legal-note">
                        <p>Вход подтвержден для {{ recipient|default(email) }}.</p>
                    </div>
                {% else %}
                    {% set currentChannel = channel|default('email') %}
                    <form class="legal-note" method="post" action="{{ path('auth_code_request') }}">
                        <p>
                            <label>
                                <input name="channel" type="radio" value="email" {{ currentChannel == 'email' ? 'checked' : '' }}>
                                Email
                            </label>
                            <label>
                                <input name="channel" type="radio" value="phone" {{ currentChannel == 'phone' ? 'checked' : '' }}>
                                Телефон
                            </label>
                        </p>
                        <p>
                            <label for="auth-email">Email</label><br>
                            <input id="auth-email" name="email" type="email" value="{{ email|default('') }}">
                        </p>
                        <p>
                            <label for="auth-phone">Телефон</label><br>
                            <input id="auth-phone" name="phone" type="tel" value="{{ phone|default('') }}" placeholder="+79XXXXXXXXX">
                        </p>
                        <button class="button" type="submit">Получить код</button>
                    </form>

                    {% if requested is defined and requested %}
                        <form class="legal-note" method="post" action="{{ path('auth_code_verify') }}">
                            <input name="email" type="hidden" value="{{ email }}">
                            <input name="phone" type="hidden" value="{{ phone|default('') }}">
                            <input name="channel" type="hidden" value="{{ currentChannel }}">
                            <p>Код выпущен для {{ recipient|default(email) }}{% if expiresAt is defined %}. Действует до {{ expiresAt|date('H:i') }}{% endif %}.</p>
                            <p>
                                <label for="auth-code">Код</label><br>
                                <input id="auth-code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" required>
                            </p>
                            <button class="button" type="submit">Подтвердить вход</button>
                        </form>
                    {% endif %}
                {% endif %}
            </div>
        </section>
    </main>

    {% include 'site/_footer.html.twig' %}
{% endblock %}
