{% extends 'base.html.twig' %}

{% block title %}Вход в ShopsBox по коду{% endblock %}
{% block meta_description %}Вход владельца магазина ShopsBox по одноразовому коду.{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}

    <main class="main">
        <section class="section">
            <div class="wrap">
                {% set phoneRequiredMode = phoneRequired is defined and phoneRequired %}
                <p class="eyebrow">{{ phoneRequiredMode ? 'Регистрация' : 'Вход в кабинет' }}</p>
                <h1>{{ phoneRequiredMode ? 'Подтвердить телефон' : 'Войти по одноразовому коду' }}</h1>
                <p class="muted">{{ phoneRequiredMode ? 'Введите номер телефона. После подтверждения вы продолжите регистрацию в личном кабинете и обязательно укажете email.' : 'Введите email, указанный при регистрации. SMS при обычном входе не требуется.' }}</p>

                {% for message in app.flashes('auth_code') %}
                    <p class="legal-note">{{ message }}</p>
                {% endfor %}

                {% if error is defined %}
                    <p class="legal-note">{{ error }}</p>
                {% endif %}

                {% if verified is defined and verified %}
                    <div class="legal-note">
                        <p>Вход подтвержден для {{ recipient|default(email) }}.</p>
                    </div>
                {% else %}
                    {% set currentChannel = channel|default('email') %}
                    {% set currentRecipient = currentChannel == 'phone' ? phone|default('') : email|default('') %}
                    <form class="legal-note auth-card" method="post" action="{{ path('auth_code_request') }}" data-auth-code-form>
                        <input name="channel" type="hidden" value="{{ phoneRequiredMode ? 'phone' : 'email' }}">
                        {% if phoneRequiredMode %}<input name="phone_required" type="hidden" value="1">{% endif %}
                        <p class="form-field">
                            <label for="auth-recipient" data-auth-recipient-label>{{ currentChannel == 'phone' ? 'Телефон' : 'Email' }}</label>
                            <input
                                id="auth-recipient"
                                name="recipient"
                                type="{{ currentChannel == 'phone' ? 'tel' : 'email' }}"
                                value="{{ currentRecipient }}"
                                placeholder="{{ currentChannel == 'phone' ? '+79XXXXXXXXX' : 'name@example.ru' }}"
                                autocomplete="{{ currentChannel == 'phone' ? 'tel' : 'email' }}"
                                data-auth-recipient-input
                                required
                            >
                        </p>
                        <button class="button" type="submit">{{ phoneRequiredMode ? 'Получить код по SMS' : 'Получить код на email' }}</button>
                    </form>

                    {% if requested is defined and requested %}
                        <form class="legal-note" method="post" action="{{ path('auth_code_verify') }}">
                            <input name="email" type="hidden" value="{{ email }}">
                            <input name="phone" type="hidden" value="{{ phone|default('') }}">
                            <input name="channel" type="hidden" value="{{ currentChannel }}">
                            {% if phoneRequiredMode %}
                                <input name="phone_required" type="hidden" value="1">
                            {% endif %}
                            <p>Код выпущен для {{ recipient|default(email) }}{% if expiresAt is defined %}. Действует до {{ expiresAt|date('H:i') }}{% endif %}.</p>
                            <p>
                                <label for="auth-code">Код</label><br>
                                <input id="auth-code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" required>
                            </p>
                            <button class="button" type="submit">{{ phoneRequiredMode ? 'Подтвердить номер' : 'Войти' }}</button>
                        </form>
                    {% endif %}
                {% endif %}
            </div>
        </section>
    </main>

    {% include 'site/_footer.html.twig' %}
{% endblock %}
