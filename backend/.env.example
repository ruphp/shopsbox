# Local template for backend environment variables.
# Copy this file to backend/.env for local Docker development.
# Do not commit real secrets or machine-specific overrides.

APP_ENV=dev
APP_SECRET=change-me-local-only
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

DATABASE_URL="postgresql://shopsbox:shopsbox@shopsbox_postgres:5432/shopsbox?serverVersion=16&charset=utf8"

FILE_STORAGE_ADAPTER=local
FILE_STORAGE_LOCAL_PATH=var/storage/files
FILE_STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files

S3_ENDPOINT=http://shopsbox_minio:9000
S3_BUCKET=shopsbox-local
S3_ACCESS_KEY=change-me-local-only
S3_SECRET_KEY=change-me-local-only
S3_REGION=us-east-1
S3_PATH_STYLE=1

NOTIFICATION_MODE=dev
MAILER_DSN=null://null
NOTIFICATION_EMAIL_FROM=no-reply@shopsbox.local
SMS_PROVIDER=dev_flash
SMS_API_BASE_URL=
SMS_API_KEY=
SIGMASMS_API_TOKEN=
SMS_SENDER=ShopsBox
