# Symfony needs this file as the default dotenv entrypoint.
# Keep only safe local defaults here. Real secrets and machine-specific values
# must go to ignored files such as backend/.env.local or backend/.env.dev.

APP_ENV=dev
APP_SECRET=shopsbox-local-dev-secret
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8080

DATABASE_URL="postgresql://shopsbox:shopsbox@shopsbox_postgres:5432/shopsbox?serverVersion=16&charset=utf8"

FILE_STORAGE_ADAPTER=local
FILE_STORAGE_LOCAL_PATH=var/storage/files
FILE_STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files

S3_ENDPOINT=http://shopsbox_minio:9000
S3_BUCKET=shopsbox-local
S3_ACCESS_KEY=shopsbox-local
S3_SECRET_KEY=shopsbox-local
S3_REGION=us-east-1
S3_PATH_STYLE=1
